# ---------------------------------------------------------------------------
# Secrets & credentials  (deny-first: nothing here should ever reach a remote)
# ---------------------------------------------------------------------------

# Private keys, certs, keystores
*.key
*.pem
*.crt
*.cert
*.cer
*.der
*.p7b
*.p12
*.pfx
*.jks
*.keystore
*.truststore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
# Extensionless cert/key dumps (e.g. base64 blobs named `cert` / `key`)
cert
key

# Environment / dotenv
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
!*.example.env

# Cloud & cluster credentials
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/
.aws/
.azure/
gcloud-service-key.json
*-service-account*.json
sa-key*.json
credentials.json
client_secret*.json

