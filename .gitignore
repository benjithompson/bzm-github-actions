api-key*.json
api_key*.json
bzm_apikey.env
bzm-api-*.json
blazemeter-credentials*
perfecto-credentials*
*.local.json
*-local.json
secrets.yaml
secrets.yml
*secret*.local.*

# Generic credential filenames (docs about credentials stay tracked)
*credential*.json
*credential*.yaml
*credential*.yml
*credential*.txt
*password*.json
*password*.txt
.netrc
.npmrc
.pypirc
.htpasswd

